# ChromaDB
CHROMA_HOST=<your_chromadb_host>
CHROMA_PORT=<your_chromadb_port>

# Firebase
FIREBASE_PROJECT_ID=<your_firebase_project_id>
GROQ_API_KEY=<your_groq_api_key>
HF_API_TOKEN=<your_huggingface_read_token>

# Observability (SigNoz via OpenTelemetry)
OTEL_SERVICE_NAME=atlasai-backend
# Self-hosted SigNoz (deployed via `foundryctl cast -f casting.yaml`,
# see casting.yaml at repo root): if you run this backend with
# `uvicorn app.main:app` directly on the host, use localhost:4318.
# If you run it via `docker compose up` instead, docker-compose.yml
# already overrides this to http://host.docker.internal:4318 so the
# container can reach SigNoz's published OTLP port on the host — no
# change needed here for that case.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SigNoz Cloud instead: use your ingest endpoint + ingestion key, e.g.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your_key>
